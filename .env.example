# Copy to .env and fill in real values. .env is gitignored — never commit secrets.

# ── Database (Supabase Postgres) ────────────────────────────────────────────
# Transaction pooler (port 6543) — used by the app at runtime.
# NOTE: if your password contains @ : / ? # [ ] or %, URL-encode it.
#       An @ must become %40 or the connection string will not parse.
DATABASE_URL="postgresql://postgres.<project-ref>:<url-encoded-password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Session pooler (port 5432) — used by `prisma migrate` / `prisma db push`.
DIRECT_URL="postgresql://postgres.<project-ref>:<url-encoded-password>@<region>.pooler.supabase.com:5432/postgres"

# ── Supabase REST (RAG vector search) ───────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
# Service role key — server-side only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=""

# ── Google Gemini (RAG embeddings + chat) ───────────────────────────────────
GEMINI_API_KEY=""

# ── Admin session signing ───────────────────────────────────────────────────
# Signs the HttpOnly admin session cookie. Must be at least 32 characters.
# Changing it invalidates every existing session.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=""

# ── Install-time: private @gokulsaraswat/* packages (.npmrc) ─────────────
# GitHub token with read:packages. Also set in Vercel + CI. Locally: export NODE_AUTH_TOKEN=$(gh auth token)
NODE_AUTH_TOKEN=""
